# Backend API this local app reports to
API_URL=http://172.233.173.181:8000

DATABASE_URL=postgresql+psycopg2://postgres.cpbjvqvxfqwxmfibmiwi:Shelf_agent_1234@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Must match an existing Camera.id in the backend database (see README)
CAMERA_ID=cam_01

# Which local webcam to use (0 = default/first camera)
CAMERA_INDEX=0

YOLO_WEIGHTS_PATH=best.pt

# How often to actually run YOLO inference, in seconds. Lower = more
# responsive detection, higher CPU/GPU load. For 24/7 unattended operation,
# 0.5–1.0s is usually plenty — you don't need 30fps analysis for inventory.
PROCESS_INTERVAL_SECONDS=0.5
CONFIRM_TICKS=3
PAIR_WINDOW_SECONDS=8
WARMUP_TICKS=4
RESULT_DISPLAY_SECONDS=180
REQUEST_TIMEOUT=120

# How often to send a full inventory snapshot regardless of other triggers
SNAPSHOT_INTERVAL_HOURS=24

FRAME_WIDTH=640
FRAME_HEIGHT=480